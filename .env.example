# Salin jadi `.env.local`, lalu isi dari Supabase → Project Settings → API.
#
# ⚠️ Aplikasi ini adalah export statis: nilai NEXT_PUBLIC_* DIBEKUKAN KE DALAM
# BUNDLE saat `npm run build`, bukan dibaca saat halaman dibuka. Mengganti
# project Supabase berarti build ulang dan deploy ulang — mengganti env di
# hosting tidak melakukan apa pun.
#
# Anon key memang semestinya sampai ke browser: ia dirancang publik, dan yang
# menjaga datanya adalah RLS — bukan kerahasiaan kuncinya.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Satu dokumen bersama untuk seluruh tim. Ganti hanya kalau ingin memisahkan
# ruang kerja (mis. simulasi lain yang tidak boleh menimpa angka tim).
NEXT_PUBLIC_DOKUMEN_ID=sos-unit-economics

# ⛔ TIDAK BOLEH berawalan NEXT_PUBLIC_ dan tidak boleh diimpor kode aplikasi.
# service_role melewati SELURUH RLS. Hanya untuk skrip server (seed, probe RLS).
SUPABASE_SERVICE_ROLE_KEY=

# Dibaca probe RLS. Tanpa ini probe MELAPORKAN DIRINYA DILEWATI, bukan lulus.
SUPABASE_DB_URL=
